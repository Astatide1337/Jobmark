# ═══════════════════════════════════════════════════════
#  DATABASE SAFETY: NEVER use production credentials here
# ═══════════════════════════════════════════════════════
#
# For local development:
#   1. Copy this to .env.local
#   2. Replace DATABASE_URL with the dev branch URL
#   3. Never commit .env.local
#
# The guard script (scripts/guard-db.sh) blocks destructive commands against
# known production endpoints. There is intentionally no local override;
# production migrations belong to the reviewed release workflow.
#
# Hosted deployments use environment-specific secrets managed outside this repository.
#

# NextAuth
AUTH_SECRET=replace-with-a-random-secret
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000

# Database — USE DEV BRANCH for local development
# Get dev URL from: neonctl connection-string <dev-branch-name>
DATABASE_URL=postgresql://user:pass@ep-dev-endpoint.aws.neon.tech/neondb?sslmode=require

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used for links opened from a connected AI app. Keep this on the same host as the deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000
MCP_PUBLIC_BASE_URL=http://localhost:3000
# Optional comma-separated browser Origins allowed to call the MCP endpoint.
# Do not use a wildcard. Leave empty unless a browser client needs access.
MCP_ALLOWED_ORIGINS=
