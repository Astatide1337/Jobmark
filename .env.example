# Required application configuration
DATABASE_URL=postgresql://user:password@localhost:5432/jobmark?sslmode=disable
AUTH_SECRET=replace-with-a-long-random-secret
AUTH_GOOGLE_ID=google-oauth-client-id
AUTH_GOOGLE_SECRET=google-oauth-client-secret

# Optional deployment URLs
AUTH_TRUST_HOST=true
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional server-side AI fallback keys. Users may configure encrypted BYOK
# keys in Settings instead.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Optional dedicated encryption secret. AUTH_SECRET is used when omitted.
JOBMARK_ENCRYPTION_KEY=

# Optional Docker tunnel token
CLOUDFLARE_TUNNEL_TOKEN=
