{
  "name": "jobmark",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:webpack": "next dev --webpack",
    "build": "prisma generate && next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:frontend": "node scripts/check-frontend-rules.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run lint && npm run typecheck && npm run test:frontend && npm run format:check",
    "db:guard": "bash scripts/guard-db.sh",
    "db:push": "npm run db:guard && prisma db push",
    "db:migrate:dev": "npm run db:guard && prisma migrate dev",
    "db:migrate:deploy": "npm run db:guard && prisma migrate deploy",
    "db:migrate:resolve": "npm run db:guard && prisma migrate resolve",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate"
  },
