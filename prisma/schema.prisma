/**
 * jobmark Database Schema
 * Why: This schema defines the professional relationship between Users,
 * their Accomplishments (Activities), and their Career Assets (Projects, Reports).
 * Key Design Decisions:
 * - Network touchpoints use InteractionLog records so relationship history is
 * kept separate from assistant connection state.
 * - Normalized Dates: `logDate` in `Activity` uses `@db.Date` (YYYY-MM-DD)
 * to ensure statistics are calculated based on calendar days, while
 * `createdAt` remains a full timestamp for ordering and audit logs.
 */

// Jobmark Database Schema
// PostgreSQL with Neon Serverless

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RateLimitBucket {
  key         String   @id
  windowStart DateTime
  count       Int
  updatedAt   DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Core application models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Legacy Settings (kept for compatibility)
  weekendStreakEnabled Boolean @default(true)
  defaultProjectId     String?

  // Relations
  accounts          Account[]
  sessions          Session[]
  projects          Project[]
  activities        Activity[]
  reports           Report[]
  goals             Goal[]
  settings          UserSettings?
  contacts          Contact[]
  interactionLogs   InteractionLog[]
  outreachDrafts    OutreachDraft[]
  mcpConnections    McpConnection[]
  decompressionLogs DecompressionLog[]
  compliance        UserCompliance?
}

enum ComplianceDocumentType {
  TERMS
  PRIVACY
}

model UserCompliance {
  id               String    @id @default(cuid())
  userId           String    @unique
  age16ConfirmedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  acceptances ComplianceAcceptance[]
}

model ComplianceAcceptance {
  id              String                 @id @default(cuid())
  complianceId    String
  documentType    ComplianceDocumentType
  documentVersion String                 @db.VarChar(50)
  acceptedAt      DateTime               @default(now())

  compliance UserCompliance @relation(fields: [complianceId], references: [id], onDelete: Cascade)

  @@unique([complianceId, documentType, documentVersion])
  @@index([complianceId, documentType, acceptedAt(sort: Desc)])
}

model Goal {
  id        String    @id @default(cuid())
  userId    String
  title     String    @db.VarChar(200) // "Decide exactly what you want"
  deadline  DateTime?
  why       String?   @db.VarChar(500) // "Why is it important"
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UserSettings {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  vaultVersion Int    @default(1)
  timeZone     String @default("America/New_York")

  // Goals (Brian Tracy Method)
  primaryGoal   String?
  goalDeadline  DateTime?
  whyStatement  String?   @db.Text
  dailyTarget   Int       @default(1)
  weeklyTarget  Int       @default(10)
  monthlyTarget Int       @default(40)

  // Report Customization
  defaultTone        String  @default("professional")
  customInstructions String? @db.Text

  // Appearance
  themePreset String @default("cafe")
  themeMode   String @default("dark")

  // Preferences
  hideArchived Boolean @default(false)
  showConfetti Boolean @default(true)

  // Vault (Password-Locked Projects)
  vaultPasswordHash String? @db.Text

  // Focus Session Configuration
  focusConfig Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DecompressionLog {
  id              String   @id @default(cuid())
  userId          String
  durationMinutes Int
  moodBefore      Int
  moodAfter       Int
  notes           String?  @db.Text
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
}

model Report {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  title     String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([projectId])
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  name        String   @db.VarChar(50)
  color       String   @default("#6366f1")
  description String?  @db.VarChar(200)
  archived    Boolean  @default(false)
  locked      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities Activity[]
  reports    Report[]

  @@index([userId])
  @@index([userId, archived])
  @@index([userId, locked])
}

model Activity {
  id        String   @id @default(cuid())
  userId    String
  projectId String?
  content   String   @db.Text
  logDate   DateTime @default(now()) @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, logDate(sort: Desc)])
  @@index([projectId])
  @@index([userId, createdAt(sort: Desc)])
}

model Contact {
  id                String    @id @default(cuid())
  userId            String
  fullName          String    @db.VarChar(150)
  phone             String?   @db.VarChar(50)
  email             String?   @db.VarChar(255)
  birthday          DateTime?
  relationship      String?   @db.VarChar(120)
  personalityTraits String?   @db.Text
  notes             String?   @db.Text
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  interactions   InteractionLog[]
  outreachDrafts OutreachDraft[]

  @@index([userId, fullName])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, email])
}

model InteractionLog {
  id           String    @id @default(cuid())
  userId       String
  contactId    String
  occurredAt   DateTime  @default(now())
  channel      String    @default("other")
  summary      String    @db.Text
  nextStep     String?   @db.Text
  followUpDate DateTime?
  rawNotes     String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, contactId, occurredAt(sort: Desc)])
  @@index([userId, followUpDate])
}

model OutreachDraft {
  id        String   @id @default(cuid())
  userId    String
  contactId String
  title     String
  content   String   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, contactId, createdAt(sort: Desc)])
}

// MCP OAuth Provider Models
model OAuthClient {
  id                      String   @id @default(cuid())
  clientId                String   @unique
  clientSecretHash        String?  @db.Text
  clientName              String
  redirectUris            String[]
  grantTypes              String[] @default(["authorization_code", "refresh_token"])
  responseTypes           String[] @default(["code"])
  scope                   String   @default("jobmark:read jobmark:write jobmark:destructive offline_access")
  requirePkce             Boolean  @default(true)
  tokenEndpointAuthMethod String   @default("client_secret_basic")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
  userId                  String? // null for public clients

  mcpConnections McpConnection[]

  @@index([clientId])
}

model OAuthAuthorizationCode {
  id                  String   @id @default(cuid())
  code                String   @unique
  codeChallenge       String?  @db.Text
  codeChallengeMethod String?
  clientId            String
  redirectUri         String
  scope               String
  userId              String
  expiresAt           DateTime
  createdAt           DateTime @default(now())

  @@index([code])
  @@index([clientId, userId])
}

model OAuthAccessToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique @db.Text
  clientId  String
  userId    String
  scope     String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?

  @@index([tokenHash])
  @@index([clientId, userId])
  @@index([userId])
}

model OAuthRefreshToken {
  id               String    @id @default(cuid())
  tokenHash        String    @unique @db.Text
  clientId         String
  userId           String
  scope            String
  accessTokenId    String?   @unique
  familyId         String    @default(cuid()) @db.Text
  consumedAt       DateTime?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  pkceCodeVerifier String?   @db.Text

  @@index([tokenHash])
  @@index([clientId, userId])
  @@index([familyId])
  @@index([accessTokenId])
}

model OAuthConsent {
  id        String   @id @default(cuid())
  clientId  String
  userId    String
  scope     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, userId])
}

// MCP Connection Models
model McpConnection {
  id                 String    @id @default(cuid())
  userId             String
  oauthClientId      String
  clientName         String
  scopes             String[]
  vaultUnlockedUntil DateTime?
  lastUsedAt         DateTime?
  revokedAt          DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  oauthClient OAuthClient @relation(fields: [oauthClientId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, oauthClientId])
  @@index([oauthClientId])
}

model McpIdempotency {
  id           String   @id @default(cuid())
  connectionId String
  toolName     String
  requestKey   String
  status       String   @default("completed") // "pending" | "completed" | "failed"
  resultJson   Json?
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([connectionId, toolName, requestKey])
  @@index([expiresAt])
}

model SecureActionNonce {
  id           String   @id @default(cuid())
  nonceHash    String   @unique @db.Text
  userId       String
  connectionId String?
  type         String // vault setup/unlock/change-password actions
  used         Boolean  @default(false)
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId, type])
  @@index([expiresAt])
}
